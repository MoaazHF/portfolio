---
import { profile } from '../data/profile';
const { eyebrow, body, quote } = profile.message;
const badge = {
  name: `${profile.name.first} ${profile.name.last}`,
  role: profile.role,
  location: profile.location.split(',')[0],
  portrait: profile.portrait,
};
---
<section class="section message" id="about">
  <div class="message__text">
    <p class="eyebrow" data-reveal>{eyebrow}</p>
    <p class="message__body" data-split>{body}</p>
    <blockquote class="message__quote" data-reveal>“{quote}”</blockquote>
  </div>
  {profile.portrait && (
    <div class="message__badge">
      <canvas data-lanyard={JSON.stringify(badge)} aria-hidden="true"></canvas>
    </div>
  )}
</section>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('[data-lanyard]');
  if (canvas) {
    new IntersectionObserver(([e], io) => {
      if (!e.isIntersecting) return;
      io.disconnect();
      import('../scripts/lanyard').then(async (m) => {
        const badge = await m.initLanyard(canvas, JSON.parse(canvas.dataset.lanyard!));
        const hero = document.querySelector<HTMLImageElement>('.hero__portrait');
        if (!hero || matchMedia('(prefers-reduced-motion: reduce)').matches) return;
        const fly = () => import('../scripts/portrait-flight').then((f) => f.initPortraitFlight(hero, badge, document.getElementById('about')!));
        hero.complete ? fly() : hero.addEventListener('load', fly, { once: true });
      });
    }, { rootMargin: '400px' }).observe(canvas);
  }
</script>
